---
import LinkButton from "./LinkButton.astro"

const { project, t } = Astro.props
---

{
  project.evolutionNote && (
    <span
      class:list={[
        "mb-3 inline-flex w-fit items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold text-white",
        project.accent.badge,
      ]}
    >
      ↳ {project.evolutionNote}
    </span>
  )
}

{
  project.media.type === "screenshot" && (
    <a
      href={project.media.href}
      target="_blank"
      rel="noopener"
      class="mb-3 block overflow-clip rounded-lg ring-1 ring-gray-200 transition hover:opacity-90 dark:ring-gray-800"
    >
      <img
        src={project.media.src}
        alt={project.title}
        loading="lazy"
        class="aspect-video w-full object-cover object-top"
      />
    </a>
  )
}
{
  project.media.type === "video" && (
    <button
      type="button"
      data-lightbox-video={project.media.src}
      data-lightbox-poster={project.media.poster}
      class="group/video relative mb-3 flex aspect-video w-full items-center justify-center overflow-clip rounded-lg bg-gray-900/90 bg-cover bg-center text-gray-200 transition hover:text-white"
      style={project.media.poster ? `background-image: url(${project.media.poster})` : undefined}
    >
      {project.media.poster && <span class="absolute inset-0 bg-black/35 transition group-hover/video:bg-black/20" />}
      <svg xmlns="http://www.w3.org/2000/svg" class="relative size-10 drop-shadow" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z" />
      </svg>
    </button>
  )
}

<ul class="mb-3 flex flex-row flex-wrap gap-2">
  {
    project.tags.map((tag: any) => (
      <li>
        <span class={`flex items-center gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}>
          <tag.icon class="size-4" />
          {tag.name}
        </span>
      </li>
    ))
  }
</ul>

<p class="mb-3 text-gray-700 dark:text-gray-400">{project.description}</p>

{project.note && <p class="mb-3 text-xs italic text-gray-500 dark:text-gray-500">{project.note}</p>}

{
  project.cta && (
    <p class="mb-3 text-sm font-medium">
      <a href={project.cta.href} class="text-blue-600 hover:underline dark:text-blue-400">
        {project.cta.label}
      </a>
    </p>
  )
}

<footer class="flex flex-wrap items-center gap-3">
  {project.media.type === "screenshot" && <LinkButton href={project.media.href}>{project.media.label}</LinkButton>}
  {
    project.media.type === "dual" &&
      project.media.links.map((link: { label: string; href?: string; video?: string }) =>
        link.video ? (
          <button
            type="button"
            data-lightbox-video={link.video}
            class="inline-flex max-w-fit items-center justify-center gap-2 rounded-xl border border-gray-300 bg-gray-100 px-3 py-2 text-md text-gray-800 transition hover:bg-gray-800 hover:border-gray-900 hover:text-white focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black dark:border-gray-600 dark:bg-gray-800 dark:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
            {link.label}
          </button>
        ) : (
          <LinkButton href={link.href}>{link.label}</LinkButton>
        )
      )
  }
  {
    project.media.type === "video" && (
      <button type="button" data-lightbox-video={project.media.src} class="text-sm text-gray-400 hover:text-gray-200">
        {t("projects.viewVideo")}
      </button>
    )
  }
</footer>