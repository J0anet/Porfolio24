---
import LinkButton from "./LinkButton.astro"
import GitHub from "./icons/GitHub.astro"
import ProjectCardBody from "./ProjectCardBody.astro"
import Lightbox from "./Lightbox.astro"
import { TAGS } from "@/data/tags.astro"
import { useTranslations, getLangFromUrl } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const RESTAURANT_TEMPLATE_URL = "https://demores1.netlify.app/"

// Els 3 projectes que expliquen l'evolució: client real -> sistema propi -> versatilitat.
const NARRATIVE_PROJECTS = [
  {
    accent: { border: "border-l-blue-500", badge: "bg-blue-500" },
    title: t("projects.restaurantTemplate.title"),
    tagline: t("projects.restaurantTemplate.tagline"),
    description: t("projects.restaurantTemplate.description"),
    tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND, TAGS.NETLIFY, TAGS.GEMINI],
    evolutionNote: null,
    cta: { label: t("projects.restaurantTemplate.businessCta"), href: "mailto:joan.enajas@gmail.com" },
    media: {
      type: "screenshot" as const,
      src: "/projects/restaurant-template.png",
      href: RESTAURANT_TEMPLATE_URL,
      label: t("projects.liveLink"),
    },
  },
  {
    accent: { border: "border-l-amber-500", badge: "bg-amber-500" },
    title: t("projects.saas.title"),
    tagline: t("projects.saas.tagline"),
    description: t("projects.saas.description"),
    evolutionNote: t("projects.saas.evolutionNote"),
    note: t("projects.saas.superadminNote"),
    tags: [TAGS.REACT, TAGS.NETLIFY_IDENTITY, TAGS.NETLIFY],
    media: {
      type: "dual" as const,
      links: [
        { label: t("projects.saas.link1"), video: "/projects/saas-client-view.mp4" },
        { label: t("projects.saas.link2"), video: "/projects/saas-superadmin.mp4" },
      ],
    },
  },
  {
    accent: { border: "border-l-emerald-500", badge: "bg-emerald-500" },
    title: t("projects.courtstats.title"),
    tagline: t("projects.courtstats.tagline"),
    description: t("projects.courtstats.description"),
    tags: [TAGS.JAVASCRIPT, TAGS.FIREBASE],
    evolutionNote: null,
    media: { type: "video" as const, src: "/projects/marcador.mp4", poster: "/projects/marcador-poster.jpg" },
  },
]

const OTHER_PROJECTS = [
  {
    title: t("projects.pizza.title"),
    description: t("projects.pizza.description"),
    github: "https://github.com/J0anet/PizzaLgust",
    image: "/projects/AllPizzas4.png",
    tags: [TAGS.KOTLIN],
  },
]
---

<!-- Acordió vertical: un fil (línia degradada) uneix els 3 passos de l'evolució -->
<div class="relative flex flex-col gap-5" id="projects-accordion">
  <div
    class="pointer-events-none absolute left-5 top-6 bottom-6 w-px bg-gradient-to-b from-blue-400 via-amber-400 to-emerald-400 opacity-40"
    aria-hidden="true"
  >
  </div>
  {
    NARRATIVE_PROJECTS.map((project, i) => (
      <div class="relative pl-14">
        <span
          class:list={[
            "absolute left-0 top-3 flex size-10 items-center justify-center rounded-full text-sm font-bold text-white shadow-md",
            project.accent.badge,
          ]}
        >
          0{i + 1}
        </span>
        <div
          class:list={[
            "overflow-clip rounded-2xl border border-l-4 border-gray-200 bg-white/70 shadow-sm transition duration-300 hover:-translate-y-0.5 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900/40",
            project.accent.border,
          ]}
        >
          <button
            type="button"
            class="accordion-trigger flex w-full items-center gap-4 px-5 py-4 text-left transition hover:bg-gray-50 dark:hover:bg-gray-900/60"
            aria-expanded={i === 0 ? "true" : "false"}
            aria-controls={`panel-${i}`}
          >
            <span class="flex-1">
              <span class="block text-lg font-bold text-gray-800 dark:text-gray-100">{project.title}</span>
              <span class="block text-sm text-gray-500 dark:text-gray-400">{project.tagline}</span>
            </span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="accordion-chevron size-5 shrink-0 text-gray-400 transition-transform duration-300"
              class:list={[{ "rotate-180": i === 0 }]}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <div
            id={`panel-${i}`}
            class="accordion-panel grid transition-[grid-template-rows] duration-300 ease-in-out"
            class:list={[i === 0 ? "grid-rows-[1fr]" : "grid-rows-[0fr]"]}
          >
            <div class="overflow-hidden">
              <div class="px-5 pb-5">
                <ProjectCardBody project={project} t={t} />
              </div>
            </div>
          </div>
        </div>
      </div>
    ))
  }
</div>

<div class="mt-16">
  <h3 class="mb-6 text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-500">
    {t("projects.otherTitle")}
  </h3>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
    {
      OTHER_PROJECTS.map(({ image, title, description, tags, github }) => (
        <article class="group flex flex-col overflow-clip rounded-xl border border-gray-200 transition hover:-translate-y-1 hover:shadow-lg dark:border-gray-800">
          <img
            alt={title}
            class="h-32 w-full object-cover transition duration-500 group-hover:scale-105"
            loading="lazy"
            src={image}
          />
          <div class="flex flex-1 flex-col gap-2 p-4">
            <h4 class="text-sm font-bold text-gray-800 dark:text-gray-100">{title}</h4>
            <ul class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <li>
                  <span class={`flex items-center gap-x-1 rounded-full text-[10px] ${tag.class} py-0.5 px-1.5`}>
                    <tag.icon class="size-3" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>
            <p class="text-xs text-gray-500 dark:text-gray-400">{description}</p>
            {github && (
              <LinkButton href={github}>
                <GitHub class="size-4" />
                {t("projects.code")}
              </LinkButton>
            )}
          </div>
        </article>
      ))
    }
  </div>
</div>

<Lightbox />

<script>
  document.addEventListener("astro:page-load", () => {
    const items = document.querySelectorAll<HTMLElement>("#projects-accordion > .relative")
    items.forEach((item, i) => {
      const trigger = item.querySelector<HTMLButtonElement>(".accordion-trigger")
      trigger?.addEventListener("click", () => {
        const isOpen = trigger.getAttribute("aria-expanded") === "true"
        items.forEach((other, j) => {
          const otherTrigger = other.querySelector<HTMLButtonElement>(".accordion-trigger")
          const otherPanel = other.querySelector<HTMLElement>(".accordion-panel")
          const otherChevron = other.querySelector<SVGElement>(".accordion-chevron")
          const shouldOpen = !isOpen && j === i
          otherTrigger?.setAttribute("aria-expanded", shouldOpen ? "true" : "false")
          otherPanel?.classList.toggle("grid-rows-[1fr]", shouldOpen)
          otherPanel?.classList.toggle("grid-rows-[0fr]", !shouldOpen)
          otherChevron?.classList.toggle("rotate-180", shouldOpen)
        })
      })
    })
  })
</script>