---
---

<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
>
  <button
    type="button"
    id="lightbox-close"
    aria-label="Tancar"
    class="absolute right-4 top-4 rounded-full bg-white/10 p-2 text-white transition hover:bg-white/20"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>
  <div id="lightbox-content" class="max-h-[85vh] max-w-full"></div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const lightbox = document.getElementById("lightbox")
    const content = document.getElementById("lightbox-content")
    const closeBtn = document.getElementById("lightbox-close")
    if (!lightbox || !content || !closeBtn) return

    const close = () => {
      lightbox.classList.add("hidden")
      lightbox.classList.remove("flex")
      content.innerHTML = ""
    }

    const openVideo = (src: string) => {
      content.innerHTML = ""
      const video = document.createElement("video")
      video.src = src
      video.controls = true
      video.autoplay = true
      video.className = "max-h-[85vh] max-w-full rounded-lg"
      content.appendChild(video)
      lightbox.classList.remove("hidden")
      lightbox.classList.add("flex")
    }

    const openImage = (src: string, alt: string) => {
      content.innerHTML = ""
      const img = document.createElement("img")
      img.src = src
      img.alt = alt
      img.className = "max-h-[85vh] max-w-full rounded-lg object-contain"
      content.appendChild(img)
      lightbox.classList.remove("hidden")
      lightbox.classList.add("flex")
    }

    document.querySelectorAll<HTMLElement>("[data-lightbox-video]").forEach((el) => {
      el.addEventListener("click", () => {
        const src = el.dataset.lightboxVideo
        if (src) openVideo(src)
      })
    })
    document.querySelectorAll<HTMLElement>("[data-lightbox-image]").forEach((el) => {
      el.addEventListener("click", () => {
        const src = el.dataset.lightboxImage
        if (src) openImage(src, el.dataset.lightboxAlt ?? "")
      })
    })

    closeBtn.addEventListener("click", close)
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) close()
    })
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close()
    })
  })
</script>