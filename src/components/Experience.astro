---
import ExperienceItem from "./ExperienceItem.astro"
import { useTranslations, getLangFromUrl } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const EXPERIENCE = [
  {
    date: t("experience.idwaste.date"),
    title: t("experience.idwaste.title"),
    company: t("experience.idwaste.company"),
    description: t("experience.idwaste.description"),
  },
  {
    date: t("experience.aduxia.date"),
    title: t("experience.aduxia.title"),
    company: t("experience.aduxia.company"),
    description: t("experience.aduxia.description"),
  },
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
